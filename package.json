{
  "name": "ieces-admin-dashboard-manager",
  "private": true,
  "version": "2.0.3",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --port 5183 --strictPort\" \"wait-on http://localhost:5183 && node scripts/dev-electron.mjs\"",
    "electron:dev": "npm run dev",
    "build": "vite build",
    "electron:build": "vite build && electron-builder",
    "preview": "vite preview",
    "dev:web": "vite"
  },
  "description": "Admin dashboard manager for IE-CES",
  "author": "Jay Bhee",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "electron-updater": "^6.8.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wait-on": "^9.5.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.8"
  }
}
