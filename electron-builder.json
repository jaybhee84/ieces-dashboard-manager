{
  "appId": "com.ieces.admin-dashboard-manager",
  "productName": "IECES Admin Dashboard",
  "directories": {
    "output": "release"
  },
  "artifactName": "IECES-Admin-Dashboard-Setup-${version}.${ext}",
  "publish": [
    {
      "provider": "github",
      "owner": "jaybhee84",
